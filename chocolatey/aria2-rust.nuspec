<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>aria2-rust</id>
    <version>0.3.7</version>
    <title>aria2-rust</title>
    <authors>aria2-rust contributors</authors>
    <projectUrl>https://github.com/balovess/aria2_rust</projectUrl>
    <projectSourceUrl>https://github.com/balovess/aria2_rust</projectSourceUrl>
    <description>Multi-protocol command-line download utility rewritten in Rust.</description>
    <summary>Rust rewrite of aria2c.</summary>
    <tags>aria2 aria2c download rust command-line</tags>
    <licenseUrl>https://github.com/balovess/aria2_rust/blob/master/LICENSE</licenseUrl>
